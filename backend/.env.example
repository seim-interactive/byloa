# Server Configuration
PORT=3000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=byloa_db

# CORS Configuration
# Comma-separated origins. Local Vite may use 5173 or 5174.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Firebase Storage Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_firebase_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Login Credentials
ADMIN_EMAIL=admin@byloa.com, admin@seiminteractive.io
